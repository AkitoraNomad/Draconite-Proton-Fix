+static const WCHAR *normalize_system_fallback_locale(const WCHAR *locale)
+{
+    const WCHAR *subtag;
+
+    if (wcsnicmp(locale, L"zh", 2) || (locale[2] != '-' && locale[2] != '_')) return locale;
+    subtag = locale + 3;
+    if (!wcsicmp(subtag, L"CN") || !wcsicmp(subtag, L"SG") ||
+            (!wcsnicmp(subtag, L"Hans", 4) && (!subtag[4] || subtag[4] == '-' || subtag[4] == '_')))
+        return L"zh-Hans";
+
+    return locale;
+}
